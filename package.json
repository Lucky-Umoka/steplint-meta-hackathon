{
  "name": "steplint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "smoke:spark": "node --conditions=react-server --import tsx scripts/smoke-spark.ts",
    "smoke:sam": "node --conditions=react-server --import tsx scripts/smoke-sam.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "@next/env": "16.4.3",
    "next": "16.4.3",
    "openai": "7.45.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
