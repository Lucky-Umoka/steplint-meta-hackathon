# Server only. Obtain your own API key from https://dev.meta.ai/ (API keys in your dashboard).
# Required for paid Teach analysis and explicitly invoked live smoke tests.
MODEL_API_KEY=

# Create your own random 32–256 character creator password (not a Meta token).
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste it here AND into the browser's Creator access code field in Teach.
# Learners do not need this code to practice already-approved local lessons.
TEACH_ACCESS_TOKEN=

# Optional exact HTTPS origin for a custom domain/proxy, with no trailing slash.
# Vercel deployment/production hostnames are recognized automatically.
TEACH_PUBLIC_ORIGIN=

# Keep blank in production. Set 1 only to deliberately enable the media lab.
ENABLE_MEDIA_LAB=

# Final Teach procedure drafting only; discovery/SAM/Voice retain Meta.
SPARK_PROVIDER=meta
# Server-only Baseten key; required when SPARK_PROVIDER=baseten.
BASETEN_API_KEY=

# Optional, non-secret build-time upload policy on self-hosted Node:
# standard (default): 12 MB body / 8 MB video, 1 Mbps H264.
# vercel: 4 MB body / 1.98 MB video, 180 kbps H264.
# Vercel builds always select vercel automatically. Rebuild after changing.
NEXT_PUBLIC_TEACH_UPLOAD_PROFILE=
